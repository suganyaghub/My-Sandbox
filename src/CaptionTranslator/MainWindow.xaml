<Window x:Class="CaptionTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CaptionTranslator"
        Title="Caption Translator" Height="460" Width="860" MinHeight="300" MinWidth="560"
        Icon="Assets/AppIcon.ico" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        WindowStyle="None" ResizeMode="CanResize" Topmost="True" FontFamily="Segoe UI Variable Text, Segoe UI"
        Loaded="OnLoaded" Closing="OnClosing" SourceInitialized="OnSourceInitialized" StateChanged="OnStateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <local:ScaleConverter x:Key="Scale" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="StatusHalo" Storyboard.TargetProperty="Opacity" From="0.6" To="0" Duration="0:0:1.4" />
            <DoubleAnimation Storyboard.TargetName="StatusHaloScale" Storyboard.TargetProperty="ScaleX" From="1" To="2.6" Duration="0:0:1.4" />
            <DoubleAnimation Storyboard.TargetName="StatusHaloScale" Storyboard.TargetProperty="ScaleY" From="1" To="2.6" Duration="0:0:1.4" />
        </Storyboard>

        <Storyboard x:Key="TypingStoryboard" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="0.25" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="0.25" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="0.25" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.8" Value="0.25" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="0.25" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.4" Value="0.25" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.7" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.0" Value="0.25" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="0.25" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="SpinStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SpinnerRotation" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1" />
        </Storyboard>

        <!-- Caption card -->
        <DataTemplate x:Key="CaptionCard" DataType="{x:Type local:CaptionLine}">
            <Border x:Name="Card" Margin="0,0,0,8" Padding="14,11" CornerRadius="12" Opacity="0"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                <Border.RenderTransform>
                    <TranslateTransform Y="10" />
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.3">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="Avatar" Width="34" Height="34" CornerRadius="17" VerticalAlignment="Top" Margin="0,2,0,0">
                        <Border.Background>
                            <SolidColorBrush Color="{Binding AvatarColor}" />
                        </Border.Background>
                        <TextBlock Text="{Binding Initials}" FontSize="12.5" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,8,0">
                        <StackPanel x:Name="Header" Orientation="Horizontal" Margin="0,0,0,3" Visibility="{Binding HasSpeaker, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Speaker}" FontSize="12.5" FontWeight="SemiBold">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{Binding AvatarColor}" />
                                </TextBlock.Foreground>
                            </TextBlock>
                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="7" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsMe, Converter={StaticResource BoolToVisibility}}" ToolTip="This is you – not read aloud when 'Don't read my own lines' is on">
                                <TextBlock Text="You" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="English" Text="{Binding EnglishDisplay, Mode=OneWay}" TextWrapping="Wrap" LineHeight="{Binding FontSize, RelativeSource={RelativeSource Self}, Converter={StaticResource Scale}, ConverterParameter=1.35}" />
                        <TextBlock Text="{Binding GermanText, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource FaintBrush}" Margin="0,4,0,0"
                                   FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Scale}, ConverterParameter=0.72}"
                                   Visibility="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                    </StackPanel>

                    <!-- One row: hover actions, live badge, time. Hidden buttons only reserve width, so short cards stay compact. -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,-6,-6,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="MarkMe" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12.5"
                                    Content="&#xE77B;" ToolTip="This is me (don't read my lines aloud)" Click="OnMarkMeClick" Visibility="Hidden" />
                            <Button x:Name="CopyLine" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12.5" Margin="0,0,4,0"
                                    Content="&#xE8C8;" ToolTip="Copy this line" Click="OnCopyLineClick" Visibility="Hidden" />
                            <Border Background="#2A3DDC97" CornerRadius="7" Padding="6,0" Margin="0,0,6,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibility}}" ToolTip="Still speaking – text and translation update live">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="5" Height="5" Fill="{StaticResource SuccessBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="live" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding TimeLabel}" FontSize="11" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsContinuation}" Value="True">
                    <Setter TargetName="Avatar" Property="Visibility" Value="Hidden" />
                    <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Card" Property="Margin" Value="0,-5,0,8" />
                    <Setter TargetName="Card" Property="Padding" Value="14,7,14,10" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTranslating}" Value="True">
                    <Setter TargetName="English" Property="Foreground" Value="{StaticResource MutedBrush}" />
                    <Setter TargetName="English" Property="FontStyle" Value="Italic" />
                </DataTrigger>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                    <Setter TargetName="CopyLine" Property="Visibility" Value="Visible" />
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, ElementName=Card}" Value="True" />
                        <Condition Binding="{Binding HasSpeaker}" Value="True" />
                        <Condition Binding="{Binding IsMe}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="MarkMe" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Image Source="Assets/AppIcon.ico" Width="18" Height="18" />
                    <TextBlock Text="Caption Translator" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="9" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="DE → EN" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ToggleButton x:Name="PinButton" Style="{StaticResource IconToggle}" Content="&#xE718;" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"
                                  WindowChrome.IsHitTestVisibleInChrome="True" Click="OnPinClick" ToolTip="Keep on top of other windows" />
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="OnMinimizeClick" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Content="&#xE922;" Click="OnMaximizeClick" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize" />
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnCloseClick" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close" />
                </StackPanel>
            </Grid>

            <!-- Toolbar -->
            <Grid Grid.Row="1" Margin="14,2,14,10">
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="9" Padding="3" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TeamsSourceOption" Style="{StaticResource SegmentOption}" GroupName="Source" Tag="Teams" Checked="OnSourceOptionChecked"
                                     ToolTip="Read the live captions of your Teams meeting (with speaker names)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE716;" Style="{StaticResource Icon}" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,7,0" />
                                <TextBlock Text="Teams captions" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="LiveSourceOption" Style="{StaticResource SegmentOption}" GroupName="Source" Tag="LiveCaptions" Checked="OnSourceOptionChecked"
                                     ToolTip="Read Windows Live Captions (any audio on this PC, no speaker names)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F0;" Style="{StaticResource Icon}" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,7,0" />
                                <TextBlock Text="Windows Live Captions" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ToggleButton x:Name="ReadAloudToggle" Style="{StaticResource FeatureToggle}" Click="OnReadAloudClick" Margin="0,0,8,0"
                                  ToolTip="Speak each English line. Use headphones so the meeting does not hear it.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ReadAloudIcon" Text="&#xE74F;" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Margin="0,0,8,0" />
                            <TextBlock Text="Read aloud" FontSize="12.5" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        </StackPanel>
                    </ToggleButton>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" Click="OnCopyClick" ToolTip="Copy all lines (English + German)" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Click="OnClearClick" ToolTip="Clear the list" />
                    <ToggleButton x:Name="SettingsToggle" Style="{StaticResource IconToggle}" Content="&#xE713;" Checked="OnSettingsToggleChanged" Unchecked="OnSettingsToggleChanged" ToolTip="Settings" Margin="2,0,0,0" />
                </StackPanel>
            </Grid>

            <!-- Content -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="Scroller" Padding="14,0,10,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              ScrollChanged="OnScrollChanged" PreviewMouseWheel="OnCaptionsMouseWheel">
                    <ItemsControl x:Name="LinesList" FontSize="18" ItemTemplate="{StaticResource CaptionCard}" Tag="{x:Static Visibility.Visible}" Margin="0,0,4,4" />
                </ScrollViewer>

                <!-- Empty state -->
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" IsHitTestVisible="False">
                    <Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource AccentGradient}" HorizontalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.55" Color="{StaticResource AccentColor}" />
                        </Border.Effect>
                        <TextBlock Text="&#xE7F0;" Style="{StaticResource Icon}" FontSize="30" Foreground="White" />
                    </Border>
                    <TextBlock x:Name="EmptyTitle" Text="Waiting for captions" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,8" />
                    <TextBlock x:Name="EmptyHint" Text="" FontSize="13.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="21" />
                </StackPanel>

                <!-- New captions pill -->
                <Button x:Name="NewCaptionsButton" Style="{StaticResource PillButton}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12"
                        Click="OnNewCaptionsClick" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="New captions" Foreground="White" />
                        <TextBlock Text="&#xE74B;" Style="{StaticResource Icon}" FontSize="11" Foreground="White" Margin="8,1,0,0" />
                    </StackPanel>
                </Button>

                <!-- Live (in progress) line -->
                <Border x:Name="PendingBar" Grid.Row="1" Margin="14,0,14,10" Padding="14,9" CornerRadius="10" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Ellipse x:Name="Dot1" Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,3,0" />
                            <Ellipse x:Name="Dot2" Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,3,0" />
                            <Ellipse x:Name="Dot3" Width="6" Height="6" Fill="{StaticResource AccentBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="PendingText" Grid.Column="1" Foreground="{StaticResource MutedBrush}" FontStyle="Italic" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Settings drawer -->
                <Border x:Name="DrawerBackdrop" Grid.RowSpan="2" Background="#99000000" Opacity="0" Visibility="Collapsed" MouseDown="OnBackdropMouseDown" />
                <Border x:Name="Drawer" Grid.RowSpan="2" Width="330" HorizontalAlignment="Right" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,0,0" CornerRadius="12,0,0,0" Visibility="Collapsed">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="DrawerShift" X="340" />
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="Black" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="18,14,10,0">
                            <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" HorizontalAlignment="Right" Click="OnCloseDrawerClick" ToolTip="Close" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,0,18,18">
                            <StackPanel>
                                <TextBlock Text="DISPLAY" Style="{StaticResource SectionHeader}" />
                                <CheckBox x:Name="ShowGermanSwitch" Style="{StaticResource ToggleSwitch}" Click="OnShowGermanClick">
                                    <StackPanel>
                                        <TextBlock Text="Show German original" FontSize="13" />
                                        <TextBlock Text="Small grey line under each translation" FontSize="11.5" Foreground="{StaticResource FaintBrush}" />
                                    </StackPanel>
                                </CheckBox>
                                <Grid Margin="0,10,0,4">
                                    <TextBlock Text="Text size" Style="{StaticResource FieldLabel}" Margin="0" />
                                    <TextBlock x:Name="FontSizeLabel" Text="18" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="FontSizeSlider" Minimum="12" Maximum="40" SmallChange="1" LargeChange="2" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnFontSizeChanged" />
                                <TextBlock Text="Tip: Ctrl + mouse wheel over the captions also zooms." FontSize="11.5" Foreground="{StaticResource FaintBrush}" Margin="0,4,0,0" />

                                <TextBlock Text="READ ALOUD" Style="{StaticResource SectionHeader}" />
                                <Border Background="#1FFFB547" CornerRadius="8" Padding="10,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7F6;" Style="{StaticResource Icon}" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Top" Margin="0,2,8,0" />
                                        <TextBlock Text="Use headphones, otherwise the meeting hears the voice." FontSize="12" TextWrapping="Wrap" Width="250" Foreground="{StaticResource TextBrush}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Output device" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="DeviceBox" SelectionChanged="OnDeviceChanged" DropDownOpened="OnDeviceDropDownOpened" />
                                <TextBlock Text="Voice" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="VoiceBox" SelectionChanged="OnVoiceChanged" />
                                <Grid Margin="0,10,0,4">
                                    <TextBlock Text="Reading volume" Style="{StaticResource FieldLabel}" Margin="0" />
                                    <TextBlock x:Name="VolumeLabel" Text="80 %" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="OnVolumeChanged" />
                                <TextBlock Text="Only the voice gets quieter; your Windows volume is not changed." FontSize="11.5" Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />

                                <CheckBox x:Name="SkipMyLinesSwitch" Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0" Click="OnSkipMyLinesClick">
                                    <StackPanel>
                                        <TextBlock Text="Don't read my own lines" FontSize="13" />
                                        <TextBlock Text="Skip what you say in the meeting" FontSize="11.5" Foreground="{StaticResource FaintBrush}" />
                                    </StackPanel>
                                </CheckBox>
                                <TextBlock Text="My name in Teams captions" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="MyNameBox" TextChanged="OnMyNameChanged" ToolTip="Exactly as Teams shows it above your captions" />
                                <TextBlock Text="Tip: hover a caption card and click the person icon to mark that speaker as you." FontSize="11.5" Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />

                                <TextBlock Text="Speed" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="SpeedBox" SelectionChanged="OnSpeedChanged">
                                    <ComboBoxItem Content="Slow" Tag="-2" />
                                    <ComboBoxItem Content="Normal" Tag="0" />
                                    <ComboBoxItem Content="Fast" Tag="2" />
                                    <ComboBoxItem Content="Faster" Tag="4" />
                                </ComboBox>
                                <Button x:Name="TestVoiceButton" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" Click="OnTestVoiceClick" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12" Foreground="White" Margin="0,0,8,0" />
                                        <TextBlock Text="Test voice" Foreground="White" />
                                    </StackPanel>
                                </Button>

                                <TextBlock Text="TROUBLESHOOTING" Style="{StaticResource SectionHeader}" />
                                <Button Style="{StaticResource SecondaryButton}" Click="OnDiagnoseClick" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                        ToolTip="Saves the window structure of the caption source, for fixing detection after a Teams update">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEBE8;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0" />
                                        <TextBlock Text="Save diagnostics file" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Click="OnOpenLogsClick" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0" />
                                        <TextBlock Text="Open log folder" />
                                    </StackPanel>
                                </Button>

                                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                    <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource SuccessBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="Everything runs on this PC. No meeting text leaves it." FontSize="11.5" Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap" Width="260" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Toast -->
                <Border x:Name="Toast" Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18" Padding="14,8" CornerRadius="10"
                        Background="{StaticResource Surface3Brush}" Opacity="0" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.5" Color="Black" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource SuccessBrush}" Margin="0,0,8,0" />
                        <TextBlock x:Name="ToastText" FontSize="12.5" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="14,7">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="10" Height="10" Margin="0,0,10,0">
                            <Ellipse x:Name="StatusHalo" Fill="{StaticResource FaintBrush}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="StatusHaloScale" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="StatusDot" Fill="{StaticResource FaintBrush}" />
                        </Grid>
                        <TextBlock x:Name="StatusText" Text="Starting…" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="480" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="Spinner" Text="&#xE895;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"
                                   RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotation" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="ModelStatusText" FontSize="12" Foreground="{StaticResource FaintBrush}" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
